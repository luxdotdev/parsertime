{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".source/**",
        "app/.well-known/workflow/**",
        "src/app/.well-known/workflow/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/lint-config/oxlint.json"]
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/lint-config/oxfmt.json"]
    }
  }
}
